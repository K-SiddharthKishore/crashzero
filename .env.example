CALL_MODE=test
CALL_PROVIDER=mock
REAL_CALLS_ENABLED=false
AUTO_TEST_CALL_ENABLED=false
INCIDENT_BLOB_MAX_BYTES=31457280
# -1 retains evidence until an operator configures deletion.
INCIDENT_RETENTION_DAYS=-1
INCIDENT_MAX_RECORDS=1000
TEST_PHONE_NUMBER=
TEST_PHONE_CONSENT=false
CALLBACK_BASE_URL=
CALL_VALIDATION_REPORT=
CALL_VALIDATION_SHA256=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_CALLER_ID=
EXOTEL_API_HOST=api.in.exotel.com
EXOTEL_FLOW_URL=

# Phase 2 Module 2 — Accident Response. Real calling stays disabled by default.
M2_CALL_MODE=mock
M2_CALL_PROVIDER=android_gateway
M2_REAL_CALLS_ENABLED=false
M2_CALL_KILL_SWITCH=true
M2_APPROVED_TEST_PHONE=
M2_TEST_PHONE_CONSENT=false
M2_TEST_ALERT_CALLS_ENABLED=false
M2_GATEWAY_TOKEN=
M2_GATEWAY_HOST=0.0.0.0
M2_GATEWAY_PORT=8766
M2_GATEWAY_QUEUE_TTL_SECONDS=120
# Optional override when Wi-Fi address detection is unavailable:
M2_GATEWAY_URL=

# Automatic two-stage verification. A grouped suspicious event triggers one paid
# request within the configured cap. Keep OPENAI_API_KEY private.
SUSPICION_THRESHOLD=0.45
SUSPICION_COOLDOWN_SECONDS=3.0
HIGH_CONFIDENCE_THRESHOLD=0.72
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4-nano
OPENAI_MAX_REQUESTS_PER_VIDEO=3
OPENAI_SESSION_BUDGET_USD=0.50
OPENAI_BUDGET_RESERVE_INPUT_TOKENS=100000
OPENAI_ESTIMATED_INPUT_TOKENS=20000
OPENAI_ESTIMATED_OUTPUT_TOKENS=1200
OPENAI_INPUT_USD_PER_MILLION=0.20
OPENAI_OUTPUT_USD_PER_MILLION=1.25
# Set the exchange rate used only for display.
OPENAI_INR_PER_USD=85
